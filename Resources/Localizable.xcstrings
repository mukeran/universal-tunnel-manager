    "Another instance changed the configuration file. Reopen the app to load the latest configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件已被其他实例修改。请重新打开应用以读取最新配置。"
