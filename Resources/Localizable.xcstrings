        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追加到 Mac 输出文件"
          }
        }
      }
    },
    "Appended to the ssh command as-is, before the host. Split on spaces, so quoted values containing spaces won't survive.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按原样追加到 ssh 命令中的主机之前。按空格拆分，因此带引号且包含空格的值会被拆开。"
          }
        }
      }
    },
