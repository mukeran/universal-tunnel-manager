      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Seconds between keepalive probes that detect a dead connection. Blank uses the default (%lld).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于检测失效连接的保活探测间隔（秒）。留空则使用默认值（%lld）。"
          }
        }
      }
    },
    "Seconds ssh waits to establish the connection before giving up. Blank = wait indefinitely.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh 放弃前等待建立连接的秒数。留空表示无限等待。"
          }
        }
      }
    },
    "Select a Device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择设备"
          }
        }
      }
    },
    "Select a device and enter valid ports.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择设备并填写有效的端口。"
          }
        }
      }
    },
    "Send": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送"
          }
        }
      }
    },
    "Send EOF": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送 EOF"
          }
        }
      }
    },
    "Serial Number": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "序列号"
          }
        }
      }
    },
    "Server listens on %@:%@ → %@:%@ on this Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器监听 %@:%@ → 此 Mac 的 %@:%@"
          }
        }
      }
    },
    "Sets -o ControlPath=<value>. The forward attaches to the master connection behind this socket instead of authenticating itself. The app never creates a master; without a live one, connecting fails with a visible reason.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 -o ControlPath=<值>。转发会附加到该套接字背后的主连接上，而不是自行认证。本应用从不创建主连接；如果没有存活的主连接，连接会失败并显示原因。"
          }
        }
      }
    },
    "Sets StrictHostKeyChecking=no and UserKnownHostsFile=/dev/null.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 StrictHostKeyChecking=no 和 UserKnownHostsFile=/dev/null。"
          }
        }
      }
    },
    "Sets TCPKeepAlive=no, so a short outage doesn't tear the connection down at the TCP layer; the Alive Interval probes above handle liveness instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 TCPKeepAlive=no，短暂中断不会在 TCP 层断开连接，改由上面的保活间隔探测来判断连接是否存活。"
          }
        }
      }
    },
    "Show Device Details": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看设备信息"
          }
        }
      }
    },
    "Show Listening Processes…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看占用进程…"
          }
        }
      }
    },
    "Show notifications when a forward connects or disconnects": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转发连接或断开时显示通知"
          }
        }
      }
    },
    "Skip host key check": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过主机密钥检查"
          }
        }
