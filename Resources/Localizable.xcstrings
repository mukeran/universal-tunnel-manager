            "value": "运行位置"
          }
        }
      }
    },
    "Run socat with sudo": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 sudo 运行 socat"
          }
        }
      }
    },
    "Run with sudo": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 sudo 运行"
          }
        }
      }
    },
    "Running": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行中"
          }
        }
      }
    },
    "Runs this instead of /usr/bin/ssh — any client that accepts OpenSSH-style -N/-L/-R/-D flags works (Teleport's tsh ssh, cloud CLI ssh wrappers, …). Passes only -N, the forwards, Extra SSH options, and the host — add anything else your command supports to Extra SSH options. Auth prompts can't be answered here, so log in (e.g. tsh login) in a terminal first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用它代替 /usr/bin/ssh 运行，任何接受 OpenSSH 风格 -N/-L/-R/-D 参数的客户端都可以（Teleport 的 tsh ssh、云平台 CLI 的 ssh 封装等）。只传递 -N、转发规则、额外 SSH 选项和主机；命令支持的其他参数请添加到额外 SSH 选项中。这里无法应答认证提示，请先在终端中登录（例如 tsh login）。"
          }
        }
      }
    },
    "SIGKILL was sent. The port is still in use.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送 SIGKILL，端口仍被占用。"
          }
        }
      }
    },
    "SIGKILL will be sent to %@ (PID %@). Unsaved data may be lost, and the process’s other connections will close.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将向 %@（PID %@）发送 SIGKILL。未保存的数据可能丢失，该进程的其他连接也会中断。"
          }
        }
      }
    },
