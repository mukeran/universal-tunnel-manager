    "The port must be between 1 and 65535.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口须为 1–65535。"
          }
        }
      }
    },
    "The process or listener changed. Refresh the list and select it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进程或监听已变化，请刷新后重新选择。"
          }
        }
      }
    },
    "The server couldn’t bind the remote-forward port — it may already be in use there (or needs root for a port below 1024).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器无法绑定远程转发端口，该端口可能已在服务器上被占用（或者 1024 以下的端口需要 root 权限）。"
          }
        }
      }
    },
    "The server refused the port forward.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了端口转发。"
          }
        }
      }
    },
    "The socat options -u and -U cannot be used together.": {
      "localizations": {
