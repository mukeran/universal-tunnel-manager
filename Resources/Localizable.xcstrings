    "Local port %@ is also used by %@. Only one tunnel can bind a port at a time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地端口 %1$@ 也被 %2$@ 使用。同一端口同一时间只能由一个隧道绑定。"
          }
        }
      }
    },
    "Local port %lld is already in use by %@. Only one tunnel can bind it at a time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地端口 %1$lld 已被 %2$@ 占用。同一时间只能有一个隧道绑定它。"
          }
        }
      }
    },
    "Local port %lld is already in use. Only one tunnel can bind it at a time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地端口 %lld 已被占用。同一时间只能有一个隧道绑定它。"
          }
        }
      }
    },
